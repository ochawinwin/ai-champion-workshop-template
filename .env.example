# คัดลอกไฟล์นี้เป็น .env.local แล้ววางค่าเอง (ห้าม commit .env.local · ห้ามให้ AI อ่านไฟล์นั้น)
# วางค่าหลังเครื่องหมาย = ไม่ต้องใส่เครื่องหมายคำพูด ไม่ต้องเว้นวรรค
# ค่าชุดเดียวกันนี้ต้องใส่ในหน้า Environment Variables ของ Vercel ด้วย (แก้ค่าแล้วต้อง Redeploy)

# --- ของบอทคุณ (ก่อนเรียน) ---
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_FALLBACK_CHANNEL_ID=

# ชื่อ-นามสกุลย่อ ตัวพิมพ์เล็ก เช่น somchai-j (ใช้เป็น label ของคิวรีใน BigQuery)
LEARNER_HANDLE=

# --- ผู้สอนแจกใน W1 ---
PORTAL_URL=
CLASS_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GCP_SA_KEY_B64=
BQ_DATASET=

# --- เพิ่มตอนทำส่วน Push (W3) ---
# ที่อยู่เว็บของคุณบน Vercel เช่น https://fs-somchai-j.vercel.app (ใช้กับ npm run cron:test)
# APP_URL=
# ข้อความสุ่มยาวอย่างน้อย 16 ตัวอักษร (ตั้งเอง) Vercel ใช้ยืนยันว่าคนเรียก /api/cron คือ Cron จริง
# CRON_SECRET=
# DATABASE_URL (Postgres สำหรับเก็บ watchlist / การสมัครรับ Brief) ไม่ต้องใส่ในไฟล์นี้
# สร้าง Neon ที่ Vercel → Storage แล้ว Vercel ใส่ใน Environment Variables ของโปรเจกต์ให้เอง
